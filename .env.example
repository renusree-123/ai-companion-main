# Environment Configuration

# Add your Groq API key below (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=

# Default Groq AI Models
AI_MODEL=groq/compound
AI_FALLBACK_MODEL=groq/compound-mini

# Database & Auth
DATABASE_URL=file:./dev.db
AUTH_SECRET=dev-only-insecure-secret-change-me
